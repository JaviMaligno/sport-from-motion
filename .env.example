# Same variable names as experiments/judge-bias, so one shell setup serves both.
# Model ids are "<route>:<deployment>"; see src/motion_sport/backends/chat.py.

# --- Claude on Microsoft Foundry (azure-anthropic:<deployment>) ---
# Endpoint of the Foundry resource, WITHOUT the /anthropic suffix:
AZURE_ANTHROPIC_ENDPOINT=        # https://<resource>.services.ai.azure.com
AZURE_ANTHROPIC_KEY=
# ...or Anthropic's own Foundry variable names (either set works):
# ANTHROPIC_FOUNDRY_RESOURCE=<resource>
# ANTHROPIC_FOUNDRY_API_KEY=

# --- GPT / Grok on the OpenAI v1 route (azure-openai:<deployment>) ---
AZURE_OPENAI_ENDPOINT=           # https://<resource>.openai.azure.com  (or .services.ai.azure.com)
AZURE_OPENAI_KEY=

# --- Other Foundry catalog models, Model Inference route (azure-foundry:<deployment>) ---
AZURE_FOUNDRY_ENDPOINT=          # https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_KEY=
# AZURE_FOUNDRY_API_VERSION=2024-05-01-preview

# --- Typed-decision models (text representation only) ---
# Jev (TypeSafe): jev:jev-latest
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# Laya behind `laya-serve` (same /v1/systemone protocol), e.g. a container on Azure:
# LAYA_BASE_URL=http://localhost:8000/v1
# LAYA_API_KEY=
# Laya in-process (laya:<checkpoint>): context budget per request
# LAYA_MAX_LEN=8192

# --- Direct vendor APIs (optional) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Hugging Face (probe encoders; only needed for gated models / faster downloads) ---
# HF_TOKEN=
